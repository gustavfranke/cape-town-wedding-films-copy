{
  "name": "AnalyticsEvent",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "page_view",
        "cta_click",
        "form_start",
        "form_submit",
        "thankyou_view"
      ]
    },
    "variant": {
      "type": "string"
    },
    "device_type": {
      "type": "string",
      "enum": [
        "mobile",
        "tablet",
        "desktop"
      ]
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "event_type"
  ]
}